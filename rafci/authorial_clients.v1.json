  "authority": "authority.rafpolimata.rafci",
  "claim_allowed": false,
  "purpose": "Classify project-owned control clients separately from external factory tools, platform ABIs and runtime evidence.",
  "invariants": [
    "SOURCE!=ARTIFACT!=EXECUTION!=EVIDENCE!=CLAIM",
    "TOKEN_VAZIO!=0",
    "IMPLEMENTED_UNTESTED!=PASS",
    "FACTORY_TOOL!=RUNTIME_DEPENDENCY",
    "PROVIDER_CONTROL!=UPSTREAM_AUTHORSHIP",
    "AUTHORIAL_CLIENT!=REIMPLEMENTED_PROVIDER",
    "LICENSE_NOTICE_PRESERVED_ON_EXISTING_OR_IMPORTED_MATERIAL"
