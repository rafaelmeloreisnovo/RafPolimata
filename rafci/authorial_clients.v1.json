    "clean_room_replacement_requires": [
      "behavioral_or_format_specification",
      "independent_implementation_record",
      "source_provenance",
      "tests_or_falsifiers",
      "file_level_license_decision"
    ],
    "new_file_license": "TOKEN_VAZIO_UNTIL_FILE_LEVEL_SCOPE_IS_RESOLVED"
  },
  "quality_method": {
    "method": "DMAIC_STYLE_ENGINEERING_NOT_CERTIFICATION",
    "define": "Identify consumer intent, runtime boundary and replaceable friction.",
    "measure": "Inventory imports, build declarations, tool versions, hashes and ABI edges.",
    "analyze": "Separate runtime dependencies from factory tools, platform APIs and optional transforms.",
    "improve": "Prefer the smallest reversible authorial control surface; never copy a provider body merely to rename it.",
    "control": "Fail closed on drift, preserve notices, exact identities, receipts and rollback."
  },
