      "comparability_group": "android_transform",
      "forbidden_promotions": ["NATIVE_RUNTIME_PASS", "FREESTANDING_STRUCTURAL", "PHYSICAL_BAREMETAL"],
      "id": "r8_dex_optimizer",
      "required_gates": ["input_identity", "rules_identity", "toolchain_identity", "output_identity", "semantic_test_binding"],
      "required_measurements": ["input_sha256", "rules_sha256", "output_sha256", "dex_bytes", "mapping_digest"]
