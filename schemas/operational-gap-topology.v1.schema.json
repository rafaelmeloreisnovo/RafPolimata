{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/rafpolimata/operational-gap-topology.v1.schema.json",
  "title": "RafPolimata Operational Gap Topology V1",
  "type": "object",
  "required": ["schema", "version", "repository", "observed_commit", "state_model", "gaps", "edges"],
  "properties": {
    "schema": {"const": "raf.operational-gap-topology.v1"},
    "version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "repository": {"type": "string", "minLength": 1},
    "observed_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "state_model": {
      "type": "object",
      "required": ["unknown_state", "claim_rule", "evidence_rule"],
      "properties": {
        "unknown_state": {"const": "TOKEN_VAZIO"},
        "claim_rule": {"type": "string", "minLength": 1},
        "evidence_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "standards_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "use"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["CURRENT_FINAL", "CURRENT_PENDING_REPLACEMENT", "DRAFT_MONITOR_ONLY"]},
          "use": {"const": "REFERENCE_ONLY_NO_CERTIFICATION_CLAIM"}
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "domain", "state", "urgency", "impact", "uncertainty_class",
          "claim_allowed", "owner_role", "required_roles", "provenance", "evidence",
          "next_action", "closure"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "domain": {"enum": ["technical", "security", "compliance", "governance", "commercial", "release", "federation", "integration", "quality", "documentation", "privacy", "legal"]},
          "state": {"enum": ["REFERENCE", "AUDIT", "IMPLEMENTED", "PENDING", "PASS", "FAIL", "TOKEN_VAZIO"]},
          "urgency": {"enum": ["P0", "P1", "P2", "P3"]},
          "impact": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "uncertainty_class": {"enum": ["OBSERVATION_MISSING", "OWNER_DECISION", "EXTERNAL_VERIFICATION", "IMPLEMENTATION_GAP", "POLICY_GAP", "STALE_STATE", "ADOPTION_GAP", "CROSS_REPO_EVIDENCE"]},
          "claim_allowed": {"type": "boolean"},
          "owner_role": {"type": "string", "minLength": 1},
          "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "next_action": {"type": "string", "minLength": 1},
          "owner_decision_required": {"type": "boolean"},
          "reference_controls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "closure": {
            "type": "object",
            "required": ["condition", "required_artifacts", "required_gates"],
            "properties": {
              "condition": {"type": "string", "minLength": 1},
              "required_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "relation", "strength", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^EDGE-[A-Z0-9-]+$"},
          "from": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
          "to": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
          "relation": {"enum": ["requires", "blocks", "supports", "governed_by", "mitigates", "observed_in", "commercializes", "evidences"]},
          "strength": {"enum": ["HARD", "SOFT"]},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
