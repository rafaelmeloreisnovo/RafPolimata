{
  "schema": "raf.repository-tracker-config.v1",
  "version": "1.0.0",
  "owner": "rafaelmeloreisnovo",
  "poll_interval_minutes": 15,
  "api": {
    "max_requests": 180,
    "timeout_seconds": 20,
    "max_repositories": 16,
    "max_commits_per_repository": 12,
    "max_forks_per_repository": 4
