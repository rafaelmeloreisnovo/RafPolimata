  "shard": {
    "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-._~",
    "width": 8,
    "snapshot_after_stable_runs": 4,
    "max_history_events": 8192
  },
  "repositories": [
