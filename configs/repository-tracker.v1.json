    {"full_name":"rafaelmeloreisnovo/termux-api_rafcodephi","priority":4,"family":"termux_android","follow_forks":true,"aliases":["termux-api"],"enabled":true},
    {"full_name":"rafaelmeloreisnovo/PCR_Rafaelia_Code_seed","priority":5,"family":"root_system","follow_forks":true,"aliases":["PCE_","PCR","magisk-derived"],"enabled":true},
    {"full_name":"rafaelmeloreisnovo/UserLAnd","priority":6,"family":"linux_distribution","follow_forks":true,"aliases":["ubuntu","debian","distribution"],"enabled":true},
    {"full_name":"rafaelmeloreisnovo/UserLAnd2","priority":7,"family":"linux_distribution","follow_forks":true,"aliases":["userland-public"],"enabled":true},
    {"full_name":"rafaelmeloreisnovo/Vectras-VM-Android","priority":8,"family":"virtualization","follow_forks":true,"aliases":["vectras","vm-android"],"enabled":true},
    {"full_name":"rafaelmeloreisnovo/qemu_rafaelia","priority":9,"family":"virtualization","follow_forks":true,"aliases":["qemu"],"enabled":true},
