+/* Parse Linux CPU-list syntax (e.g. "0-7", "0-3,6-7") without heap. */
+static u32 cpu_count_list(const char *s){
+    if(!s || !*s) return 0;
+    u32 total=0; const char *p=s;
+    while(*p){
+        while(*p==' '||*p=='\t'||*p=='\n'||*p==',') p++;
+        if(*p<'0'||*p>'9') break;
+        u32 a=0;
+        while(*p>='0'&&*p<='9'){ a=a*10u+(u32)(*p-'0'); p++; }
+        u32 b=a;
+        if(*p=='-'){
+            p++;
+            if(*p<'0'||*p>'9') return 0;
+            b=0;
+            while(*p>='0'&&*p<='9'){ b=b*10u+(u32)(*p-'0'); p++; }
+            if(b<a) return 0;
+        }
+        total += (b-a)+1u;
+        while(*p==' '||*p=='\t') p++;
+        if(*p==','){ p++; continue; }
+        if(*p=='\n'||*p=='\r'||*p=='\0') break;
+        if(*p) return 0;
+    }
+    return total;
+}
+
+static u32 rd_cpu_count_file(const char *path){
+    char b[96]; int fd=open(path,O_RDONLY|O_CLOEXEC);
+    if(fd<0) return 0;
+    ssize_t n=read(fd,b,sizeof(b)-1u); close(fd);
+    if(n<=0) return 0;
+    b[n]=0;
+    return cpu_count_list(b);
+}
+
