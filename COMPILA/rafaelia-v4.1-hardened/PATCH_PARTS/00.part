diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..baa2843
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,19 @@
+# Android.mk — RAFAELIA V4.1 hardened baseline
+# C/JNI-only shared library. ARM assembly is intentionally excluded until
+# each .S passes architecture-specific assemble/link/run gates on real devices.
+LOCAL_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := rafaelia_core
+LOCAL_SRC_FILES := baremetal_nomalloc.c rafaelia_jni_direct.c
+LOCAL_C_INCLUDES := $(LOCAL_PATH)
+LOCAL_CFLAGS := -O2 -fno-stack-protector -DNDEBUG -D_GNU_SOURCE
+ifeq ($(TARGET_ARCH_ABI),armeabi-v7a)
+LOCAL_CFLAGS += -march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=softfp -DHAS_NEON
+endif
+ifeq ($(TARGET_ARCH_ABI),arm64-v8a)
+LOCAL_CFLAGS += -march=armv8-a -DHAS_NEON -DRAF_ARCH64
+endif
+LOCAL_LDFLAGS := -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384 -Wl,--gc-sections -Wl,-z,relro -Wl,-z,now
+LOCAL_LDLIBS := -llog -ldl -lm
+include $(BUILD_SHARED_LIBRARY)
diff --git a/RafaeliaCore.java b/RafaeliaCore.java
index 0a12d14..3082d9f 100644
--- a/RafaeliaCore.java
+++ b/RafaeliaCore.java
@@ -27,13 +27,15 @@ public final class RafaeliaCore {
         OUT_BUF   = ByteBuffer.allocateDirect(OUT_CAP).order(ByteOrder.nativeOrder());
         STATE_BUF = ByteBuffer.allocateDirect(STATE_CAP).order(ByteOrder.nativeOrder());
 
-        // Inicializa estado no buffer nativo
+        // Inicializa estado no buffer nativo com atribuição única do blank-final.
+        boolean loaded;
         try {
             System.loadLibrary("rafaelia_core");
-            _libLoaded = true;
+            loaded = true;
         } catch (UnsatisfiedLinkError e) {
-            _libLoaded = false;
+            loaded = false;
         }
+        _libLoaded = loaded;
     }
 
     private static final boolean _libLoaded;
