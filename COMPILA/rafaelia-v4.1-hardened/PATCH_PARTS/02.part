
@@ -254,7 +289,8 @@ static u32    g_commits=0, g_rollbacks=0;
 #define CG_PROC   0x2u
 #define CG_VERIFY 0x4u
 #define CG_COMMIT 0x8u
-#define CG_ALL    0xFu
+#define CG_PRECOMMIT (CG_LOAD|CG_PROC|CG_VERIFY)
+#define CG_ALL       (CG_PRECOMMIT|CG_COMMIT)
 
 static void cg_step(u32 core){
     vcpu_t *v=&g_vcpu[core];
@@ -277,9 +313,11 @@ static void cg_step(u32 core){
         g_cg_bm[core]=0; g_rollbacks++; return;
     }
     g_cg_bm[core]|=CG_VERIFY;
-    /* COMMIT */
-    if((g_cg_bm[core]&CG_ALL)==CG_ALL){
-        v->crc_s=sc; g_cg_bm[core]=0; g_commits++;
+    /* COMMIT: prerequisites first, then atomically expose commit state. */
+    if((g_cg_bm[core]&CG_PRECOMMIT)==CG_PRECOMMIT){
+        g_cg_bm[core]|=CG_COMMIT;
+        v->crc_s=sc; g_commits++;
+        g_cg_bm[core]=0;
     }
 }
 
