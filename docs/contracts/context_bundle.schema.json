{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rafaelia.context_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "chunk_refs", "constraints", "created_at"],
  "properties": {
    "schema": { "const": "rafaelia.context_bundle.v1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "chunk_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
