    "bash scripts/ci_freestanding_audit.sh",
    "bash freestanding/tests/verify_contract.sh"
  ],
  "freestanding_evidence": "ci/reports/freestanding-audit.md",
  "integration": {
    "body_copy_allowed": false,
    "authority_transfer_allowed": false,
    "contract_or_artifact_boundary_required": true
  },
  "claim_allowed": false
}
