{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafpolimata.local/contracts/language-matrix-commit-evidence.schema.json",
  "title": "RafPolimata language matrix commit evidence ledger",
  "type": "object",
  "required": [
    "schema", "version", "repository", "branch", "scope", "base_sha",
    "observed_head_sha", "branch_relation", "claim_allowed",
    "evidence_scope", "fixture", "commits", "limits", "next_gate"
  ],
  "properties": {
    "schema": {"const": "raf.language-matrix-commit-ledger.v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repository": {"const": "rafaelmeloreisnovo/RafPolimata"},
    "branch": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch_relation": {
      "type": "object",
      "required": ["ahead_by", "behind_by", "observed_via"],
      "properties": {
        "ahead_by": {"type": "integer", "minimum": 1},
        "behind_by": {"const": 0},
        "observed_via": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "claim_allowed": {"const": false},
    "evidence_scope": {"type": "object"},
    "fixture": {
      "type": "object",
      "required": ["path", "sha256", "classification"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "classification": {"const": "HASHED_ENGINEERING_FIXTURE_NOT_CORPUS"}
      },
      "additionalProperties": false
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "sha", "message", "artifacts", "gate_contribution", "existence"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "message": {"type": "string", "minLength": 1},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "gate_contribution": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "existence": {"const": "VERIFIED_GITHUB_API"}
        },
        "additionalProperties": false
      }
    },
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
